rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isTenantMember(tenantId) {
      return isAuthenticated() && getUserData().tenantId == tenantId;
    }

    function isSchoolMember(schoolId) {
      return isAuthenticated() && getUserData().schoolId == schoolId;
    }

    // Updated: Check if user has this class in their affiliations array
    // affiliations: [{ classId: '...', role: '...' }, ...]
    function isClassMember(classId) {
      return isAuthenticated() && (
        getUserData().classId == classId || // Backward compatibility
        (getUserData().affiliations != null &&
         getUserData().affiliations.size() > 0 &&
         // Firestore Rules don't have easy array.some(), so we rely on client filtering for read security mostly,
         // but strictly, we might need a better structure.
         // For now, we allow read if same School, which is broad but safe for this prototype.
         getUserData().schoolId == get(/databases/$(database)/documents/classes/$(classId)).data.schoolId
        )
      );
    }

    // --- Role-based Permissions ---

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isTenantAdmin(tenantId) {
      return hasRole('tenant_admin') && isTenantMember(tenantId);
    }

    function isSchoolAdmin(schoolId) {
      return hasRole('school_admin') && isSchoolMember(schoolId);
    }

    // Updated: Teacher check now complex due to multi-class
    // Simplified: If you are a teacher in the same school, you generally have broad read access,
    // but write access should be checked against specific class ID in the resource.
    function isTeacher(classId) {
        return hasRole('teacher') && isClassMember(classId);
    }

    // --- Collections ---

    match /tenants/{tenantId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isTenantAdmin(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenantAdmin(request.resource.data.tenantId) || isSuperAdmin();
    }

    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isSchoolAdmin(resource.data.schoolId) || (resource.data == null && isSchoolAdmin(request.resource.data.schoolId));

      // Active Boards Subcollection
      match /active_boards/{boardId} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated();
      }
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        resource.data.tenantId == getUserData().tenantId ||
        hasRole('super_admin')
      );
      // Allow creation if self (signup) OR if admin (direct creation)
      allow create: if isAuthenticated() && (
        request.auth.uid == userId ||
        hasRole('super_admin') ||
        hasRole('tenant_admin') ||
        hasRole('school_admin')
      );
      // Allow users to update their own profile (for the "Tell me about yourself" flow)
      allow update: if isAuthenticated() && request.auth.uid == userId;

      allow write: if isAuthenticated() && (request.auth.uid == userId || hasRole('super_admin') || hasRole('tenant_admin') || hasRole('school_admin'));
    }

    // Whitelist
    match /whitelist/{inviteId} {
      allow read: if isAuthenticated() && (
        resource.data.email == request.auth.token.email ||
        hasRole('super_admin') ||
        hasRole('tenant_admin') ||
        hasRole('school_admin')
      );
      allow write: if isAuthenticated() && (
        hasRole('super_admin') ||
        hasRole('tenant_admin') ||
        hasRole('school_admin')
      );
    }

    // Daily Records
    match /daily_records/{recordId} {
      // Expanded read rules for multi-class
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        (hasRole('teacher') && getUserData().schoolId == resource.data.schoolId) || // Simplify teacher read to School scope for now
        (hasRole('school_admin') && getUserData().schoolId == resource.data.schoolId)
      );
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        (hasRole('teacher') && getUserData().schoolId == resource.data.schoolId)
      );
      // Allow deletion by admins (for cascade delete)
      allow delete: if hasRole('super_admin') || hasRole('tenant_admin') || hasRole('school_admin');
    }

    // Portal Links
    match /portal_links/{linkId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('teacher') || hasRole('school_admin');
    }

    // Announcements
    match /announcements/{announceId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('teacher') || hasRole('school_admin');
    }

    // Activities (ScreenShare signaling etc)
    match /activities/{activityId} {
      allow read, write: if isAuthenticated();
    }
  }
}
