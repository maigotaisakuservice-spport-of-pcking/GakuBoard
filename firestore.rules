rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isTenantMember(tenantId) {
      return isAuthenticated() && getUserData().tenantId == tenantId;
    }

    function isSchoolMember(schoolId) {
      return isAuthenticated() && getUserData().schoolId == schoolId;
    }

    function isClassMember(classId) {
      return isAuthenticated() && (
        getUserData().classId == classId ||
        (getUserData().affiliations != null && getUserData().schoolId == get(/databases/$(database)/documents/classes/$(classId)).data.schoolId)
      );
    }

    // --- Role-based Permissions ---

    function isSuperAdmin() {
      return hasRole('super_admin');
    }

    function isTenantAdmin(tenantId) {
      return hasRole('tenant_admin') && isTenantMember(tenantId);
    }

    function isSchoolAdmin(schoolId) {
      return hasRole('school_admin') && isSchoolMember(schoolId);
    }

    function isTeacher(classId) {
        return hasRole('teacher') && isClassMember(classId);
    }

    // --- Collections ---

    match /tenants/{tenantId} {
      allow read: if isAuthenticated();
      allow write: if isSuperAdmin();
    }

    match /schools/{schoolId} {
      allow read: if isAuthenticated();
      allow write: if isTenantAdmin(resource.data.tenantId) || isSuperAdmin();
      allow create: if isTenantAdmin(request.resource.data.tenantId) || isSuperAdmin();
    }

    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isSchoolAdmin(resource.data.schoolId) || (resource.data == null && isSchoolAdmin(request.resource.data.schoolId));

      // Active Boards Subcollection
      match /active_boards/{boardId} {
          allow read: if isAuthenticated();
          allow write: if isAuthenticated();
      }
    }

    // Users
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        resource.data.tenantId == getUserData().tenantId ||
        hasRole('super_admin')
      );
      allow create: if isAuthenticated() && (
        request.auth.uid == userId ||
        hasRole('super_admin') ||
        hasRole('tenant_admin') ||
        hasRole('school_admin')
      );
      // Fixed: Prevent Privilege Escalation
      // Allow self-update ONLY if role, schoolId, and tenantId are NOT changed.
      allow update: if isAuthenticated() && request.auth.uid == userId
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.schoolId == resource.data.schoolId
                    && request.resource.data.tenantId == resource.data.tenantId;

      allow write: if isAuthenticated() && (request.auth.uid == userId || hasRole('super_admin') || hasRole('tenant_admin') || hasRole('school_admin'));
    }

    // Whitelist
    match /whitelist/{inviteId} {
      allow read: if isAuthenticated() && (
        resource.data.email == request.auth.token.email ||
        hasRole('super_admin') ||
        hasRole('tenant_admin') ||
        hasRole('school_admin')
      );
      allow write: if isAuthenticated() && (
        hasRole('super_admin') ||
        hasRole('tenant_admin') ||
        hasRole('school_admin')
      );
    }

    // Daily Records
    match /daily_records/{recordId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        (hasRole('teacher') && getUserData().schoolId == resource.data.schoolId) ||
        (hasRole('school_admin') && getUserData().schoolId == resource.data.schoolId)
      );
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        (hasRole('teacher') && getUserData().schoolId == resource.data.schoolId)
      );
      allow delete: if hasRole('super_admin') || hasRole('tenant_admin') || hasRole('school_admin');
    }

    // Portal Links
    match /portal_links/{linkId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('teacher') || hasRole('school_admin');
    }

    // Announcements
    match /announcements/{announceId} {
      allow read: if isAuthenticated();
      allow write: if hasRole('teacher') || hasRole('school_admin');
    }

    // Activities (ScreenShare signaling etc)
    match /activities/{activityId} {
      allow read, write: if isAuthenticated();
    }

    // --- NEW: Integrations (School Settings for Google/Teams) ---
    match /integrations/{schoolId} {
      allow read: if isAuthenticated() && isSchoolMember(schoolId); // Students/Teachers can read (e.g. to see if sync is on?) or mainly admins.
      // School Admin writes, Tenant Admin writes (maybe)
      allow write: if isSchoolAdmin(schoolId) || isTenantAdmin(get(/databases/$(database)/documents/schools/$(schoolId)).data.tenantId);
    }

    // --- NEW: MEXCBT Tests (Master Data) ---
    match /mexcbt_tests/{testId} {
      allow read: if isAuthenticated(); // Everyone can read available tests
      allow write: if isSuperAdmin() || hasRole('tenant_admin'); // Tenants create tests?
    }

    // --- NEW: MEXCBT Assignments (Distribution) ---
    match /mexcbt_assignments/{assignId} {
      allow read: if isAuthenticated() && (
        resource.data.targetType == 'tenant' && getUserData().tenantId == resource.data.targetId ||
        resource.data.targetType == 'school' && getUserData().schoolId == resource.data.targetId ||
        resource.data.targetType == 'class' && isClassMember(resource.data.targetId) ||
        resource.data.targetType == 'student' && resource.data.targetId == request.auth.uid
      );
      allow write: if hasRole('tenant_admin') || hasRole('school_admin');
    }

    // --- NEW: MEXCBT Results (Student Answers) ---
    match /mexcbt_results/{resultId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid ||
        (hasRole('teacher') && isClassMember(resource.data.classId)) ||
        (hasRole('school_admin') && isSchoolMember(resource.data.schoolId)) ||
        (hasRole('tenant_admin') && isTenantMember(resource.data.tenantId))
      );
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid || // Reflection
        hasRole('teacher') // Grading?
      );
    }
  }
}
